#!/usr/bin/env python3
"""Generate antora1000 platform.json properties from HU dump + TSV + legacy bindings."""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
ANTORA = ROOT / "integrations/antora1000/src/main/assets"
DUMP_ALL = ROOT / ".local/oem-apks/analysis/hu_carpropertyconfig_all.json"
DUMP_RAW = ROOT / ".local/oem-apks/analysis/hu_carpropertyconfig_raw.txt"
TSV = ANTORA / "vhal_named_ids.tsv"
LEGACY = ANTORA / "platform.json"
OUT = ANTORA / "platform.json"

ACCESS_MAP = {"READ": "r", "WRITE": "w", "READ_WRITE": "rw", 1: "r", 2: "w", 3: "rw"}
CHANGE_MAP = {
    "STATIC": "static",
    "ON_CHANGE": "on_change",
    "CONTINUOUS": "continuous",
    0: "static",
    1: "on_change",
    2: "continuous",
}

# Fallback multi-area hints from AntoraCatalog.areasFor (when dump has no areas).
AREAS_FALLBACK = {
    0x15200510: [5, 0x75],  # HVAC_POWER
    0x15400500: [5, 0x75],  # FAN_SPEED
    0x15400501: [1, 5, 0x75],  # FAN_DIRECTION
    0x15200505: [0x75, 5, 1],  # AC
    0x15200508: [0x75, 5, 1],  # RECIRC
    0x15200507: [0x75, 5, 1],  # MAX_DEFROST
    0x15200506: [0x75, 5, 1],  # MAX_AC
    0x252070b0: [0x75, 5, 1],  # HVAC_ECO
    0x1520050a: [1, 0x75, 5],  # AUTO
    0x15400513: [1, 0x75, 5],  # SEAT_VENT
    0x15600503: [1],  # TEMP
    0x254071c3: [5, 0],  # AMBIENCE_INTENSITY
    0x23207156: [0x10000, 0],  # SUNROOF
}


def parse_id(raw) -> int:
    if isinstance(raw, int):
        return raw & 0xFFFFFFFF
    s = str(raw).strip()
    if s.lower().startswith("0x"):
        return int(s, 16) & 0xFFFFFFFF
    return int(s) & 0xFFFFFFFF


def hex_id(i: int) -> str:
    return f"0x{i & 0xFFFFFFFF:08x}"


def load_tsv_names() -> dict[int, str]:
    names: dict[int, str] = {}
    if not TSV.is_file():
        return names
    for line in TSV.read_text().splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        name = parts[2].strip()
        if name and not name.lower().startswith("0x"):
            names[pid & 0xFFFFFFFF] = name
    return names


def load_areas_from_raw() -> dict[int, list[int]]:
    areas: dict[int, list[int]] = {}
    if not DUMP_RAW.is_file():
        return areas
    text = DUMP_RAW.read_text(errors="replace")
    blocks = re.split(r"(?=Property:0x)", text)
    for block in blocks:
        m = re.match(r"Property:(0x[0-9a-fA-F]+)", block)
        if not m:
            continue
        pid = parse_id(m.group(1))
        found = [parse_id(x) for x in re.findall(r"areaId:(0x[0-9a-fA-F]+|\d+)", block)]
        if found:
            seen = set()
            uniq = []
            for a in found:
                if a not in seen:
                    seen.add(a)
                    uniq.append(a)
            areas[pid] = uniq
    return areas


def load_legacy() -> tuple[dict, dict[int, dict], set[int], dict[int, str]]:
    legacy = json.loads(LEGACY.read_text())
    by_id: dict[int, dict] = {}
    allow: set[int] = set()
    names: dict[int, str] = {}

    bindings = legacy.get("bindings") or {}
    for entity, b in bindings.items():
        pid = parse_id(b.get("nativeId") or b.get("id"))
        by_id[pid] = {
            "entity": entity,
            "areaId": int(b.get("areaId", 0)),
            "functionId": b.get("functionId"),
        }
    for x in legacy.get("writableAllowlist") or []:
        allow.add(parse_id(x))

    # Current schema: properties carry entity / access / key.
    for p in legacy.get("properties") or []:
        pid = parse_id(p.get("id") or p.get("nativeId"))
        key = (p.get("key") or "").strip()
        if key:
            names[pid] = key
        entity = p.get("entity")
        if entity:
            areas = p.get("areas") or [p.get("areaId", 0)]
            by_id[pid] = {
                "entity": entity,
                "areaId": int(areas[0]) if areas else 0,
                "functionId": p.get("functionId"),
            }
        if p.get("access") in ("w", "rw") or p.get("writable"):
            allow.add(pid)

    return legacy, by_id, allow, names


def access_of(entry: dict) -> str:
    a = entry.get("access")
    if a in ACCESS_MAP:
        return ACCESS_MAP[a]
    raw = entry.get("accessRaw")
    if raw in ACCESS_MAP:
        return ACCESS_MAP[raw]
    return "r"


def change_of(entry: dict) -> str | None:
    c = entry.get("changeMode")
    if c is None:
        return None
    if c in CHANGE_MAP:
        return CHANGE_MAP[c]
    if isinstance(c, str):
        return c.lower().replace("-", "_")
    return str(c)


def main() -> int:
    if not DUMP_ALL.is_file():
        print(f"missing dump: {DUMP_ALL}", file=sys.stderr)
        return 1
    hu = json.loads(DUMP_ALL.read_text())
    areas_raw = load_areas_from_raw()
    legacy, bind_by_id, allow, prop_names = load_legacy()
    names = {**prop_names, **load_tsv_names()}

    props: list[dict] = []
    seen: set[int] = set()

    for entry in hu:
        pid = parse_id(entry["propertyId"])
        seen.add(pid)
        hu_name = entry.get("name") or ""
        key = names.get(pid)
        if not key:
            if hu_name and not str(hu_name).lower().startswith("0x"):
                key = str(hu_name)
            else:
                key = hex_id(pid)
        areas = areas_raw.get(pid) or AREAS_FALLBACK.get(pid)
        bind = bind_by_id.get(pid)
        if not areas:
            if bind:
                areas = [bind["areaId"]]
            else:
                areas = [0]
        # Product access: allowlist → rw; otherwise r (even if HU reports RW).
        access = "rw" if pid in allow else "r"
        obj: dict = {
            "id": hex_id(pid),
            "key": key,
            "access": access,
            "changeMode": change_of(entry) or "on_change",
            "areas": areas,
        }
        if bind:
            obj["entity"] = bind["entity"]
            # Prefer binding default area first for product reads/writes.
            pref = bind["areaId"]
            if pref in areas:
                areas = [pref] + [a for a in areas if a != pref]
            else:
                areas = [pref] + areas
            obj["areas"] = areas
            if bind.get("functionId") is not None:
                obj["functionId"] = bind["functionId"]
        props.append(obj)

    # Bindings present in platform.json but missing from HU dump (keep them).
    for pid, bind in bind_by_id.items():
        if pid in seen:
            continue
        areas = AREAS_FALLBACK.get(pid) or [bind["areaId"]]
        obj = {
            "id": hex_id(pid),
            "key": names.get(pid, bind["entity"]),
            "access": "rw" if pid in allow else "r",
            "changeMode": "on_change",
            "areas": areas,
            "entity": bind["entity"],
        }
        props.append(obj)

    props.sort(key=lambda p: parse_id(p["id"]))

    # Preserve existing android overlay when regenerating.
    android_overlay = legacy.get("android") or {
        "volumeGroups": [
            {
                "groupId": 0,
                "settingsKey": "android.car.VOLUME_GROUP/0",
                "entity": "cabin_vol_media",
                "access": "rw",
                "writeVia": "media_keyevent",
            },
            {
                "groupId": 2,
                "settingsKey": "android.car.VOLUME_GROUP/2",
                "entity": "cabin_vol_navigation",
                "access": "r",
            },
            {
                "groupId": 6,
                "settingsKey": "android.car.VOLUME_GROUP/6",
                "entity": "cabin_vol_voice",
                "access": "r",
            },
            {
                "groupId": 3,
                "settingsKey": "android.car.VOLUME_GROUP/3",
                "entity": "cabin_vol_call",
                "access": "r",
            },
            {
                "groupId": 7,
                "settingsKey": "android.car.VOLUME_GROUP/7",
                "entity": "cabin_vol_ring",
                "access": "r",
            },
        ]
    }

    out = {
        "id": legacy["id"],
        "displayName": legacy.get("displayName", legacy["id"]),
        "backend": legacy.get("backend", "vhal"),
        "extends": legacy.get("extends") or ["aosp", "android"],
        "match": legacy.get("match", []),
        "capabilities": legacy.get("capabilities", []),
        "dvr": legacy.get("dvr"),
        "variants": legacy.get("variants", []),
        "driveModeEnum": legacy.get("driveModeEnum", {}),
        "android": android_overlay,
        "properties": props,
    }
    # Drop null dvr
    if not out["dvr"]:
        del out["dvr"]

    OUT.write_text(json.dumps(out, indent=2) + "\n")
    bound = sum(1 for p in props if "entity" in p)
    writable = sum(1 for p in props if p.get("access") in ("w", "rw"))
    print(f"wrote {OUT} props={len(props)} bound={bound} writable={writable}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
